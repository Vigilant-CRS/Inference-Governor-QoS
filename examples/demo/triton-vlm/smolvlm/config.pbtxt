name: "smolvlm"
backend: "python"
# SmolVLM-500M-Instruct (Apache-2.0), eine Frage je Aufruf, ein nicht
# unterbrechbarer GPU-Block. Gewichte unter /weights gemountet.
max_batch_size: 0
input [
  { name: "IMAGE", data_type: TYPE_UINT8, dims: [ -1, -1, 3 ] },
  { name: "PROMPT", data_type: TYPE_STRING, dims: [ 1 ] },
  { name: "MAX_TOKENS", data_type: TYPE_INT32, dims: [ 1 ], optional: true }
]
output [ { name: "TEXT", data_type: TYPE_STRING, dims: [ 1 ] } ]
instance_group [ { count: 1, kind: KIND_GPU } ]
